# All optional.
PORT=4173
# 127.0.0.1 = only this machine. Use 0.0.0.0 inside Docker / on a server.
HOST=127.0.0.1
# Lock the app to one Jira (hides the URL field on the login page).
# JIRA_BASE_URL=https://jira.example.com
# Prefill the project field on the login page.
# DEFAULT_PROJECT=DMA
# Where trend history is stored.
# DATA_DIR=./data
# SESSION_TTL_MINUTES=480
# REPORT_CACHE_SECONDS=30
# Set to true when running behind an HTTPS reverse proxy (secure cookies).
# TRUST_PROXY=true
# PROJECTS_CONFIG=./config/projects.json
